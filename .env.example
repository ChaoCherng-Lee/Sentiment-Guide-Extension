# Sharing with a parent's dashboard (optional). Leave empty and the extension
# never contacts Supabase. Copy to .env and fill in from
# Supabase dashboard → Project Settings → API.
# The anon key is safe to ship only with the rules in supabase/migrations/.
WXT_SUPABASE_URL=
WXT_SUPABASE_ANON_KEY=

# Remote site selectors (optional, Plan 12.3). A signed JSON file fetched once
# a day; leave empty and only the built-in selectors are used.
# Make the key pair with: node scripts/selectors.mjs keygen <private-key.jwk>
WXT_SELECTORS_URL=
WXT_SELECTORS_PUBLIC_KEY=
